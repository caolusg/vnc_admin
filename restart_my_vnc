#!/usr/bin/env bash

set -u
set -o pipefail

XSTARTUP="/share/apps/vnc/mate.xstartup"

log() {
  printf '%s\n' "$*"
}

die() {
  printf '错误：%s\n' "$*" >&2
  exit 1
}

kill_xvnc() {
  local user="$1"
  local display_num="$2"

  pgrep -u "$user" -f "Xvnc :${display_num}([[:space:]]|$)" |
    while IFS= read -r pid; do
      kill "$pid" || true
    done
}

CURRENT_USER="$(whoami)"
LOG_FILE="/tmp/restart_my_vnc.${CURRENT_USER}.$$ .log"
LOG_FILE="${LOG_FILE// /}"

if [ -z "${DISPLAY:-}" ]; then
  die "没有检测到 DISPLAY，请确认你是在 VNC 桌面终端里执行。"
fi

DISPLAY_VALUE="${DISPLAY#:}"
DISPLAY_NUM="${DISPLAY_VALUE%%.*}"

if ! [[ "$DISPLAY_NUM" =~ ^[0-9]+$ ]]; then
  die "DISPLAY 格式不正确，必须能提取出纯数字 display 号。当前 DISPLAY=${DISPLAY}"
fi

if [ -z "$CURRENT_USER" ]; then
  die "无法识别当前用户。"
fi

if [ ! -x "$XSTARTUP" ]; then
  die "xstartup 不存在或不可执行：$XSTARTUP"
fi

log "普通用户重启 VNC"
log "用户: $CURRENT_USER"
log "Display: :$DISPLAY_NUM"
log "日志: $LOG_FILE"
log

log "[1/4] 创建后台重启任务..."
RESTART_JOB="$(mktemp "/tmp/restart_my_vnc.${CURRENT_USER}.${DISPLAY_NUM}.XXXXXX")" ||
  die "无法创建临时重启脚本。"
chmod 700 "$RESTART_JOB"
cat >"$RESTART_JOB" <<EOF
#!/usr/bin/env bash
set -u
set -o pipefail

XSTARTUP="$XSTARTUP"
CURRENT_USER="$CURRENT_USER"
DISPLAY_NUM="$DISPLAY_NUM"
LOG_FILE="$LOG_FILE"

{
  printf '%s\n' "[后台] 等待当前 VNC 关闭..."
  sleep 3

  printf '%s\n' "[后台] 清理 Xvnc..."
  pgrep -u "\$CURRENT_USER" -f "Xvnc :\${DISPLAY_NUM}([[:space:]]|\$)" |
    while IFS= read -r pid; do
      kill "\$pid" || true
    done

  printf '%s\n' "[后台] 删除锁文件..."
  rm -f "/tmp/.X\${DISPLAY_NUM}-lock"
  rm -f "/tmp/.X11-unix/X\${DISPLAY_NUM}"

  printf '%s\n' "[后台] 重新启动 VNC..."
  vncserver ":\$DISPLAY_NUM" \\
    -depth 24 \\
    -geometry 1920x1080 \\
    -xstartup "\$XSTARTUP"
  status=\$?

  rm -f "$RESTART_JOB"
  exit "\$status"
} >>"\$LOG_FILE" 2>&1
EOF

if command -v setsid >/dev/null 2>&1; then
  nohup setsid "$RESTART_JOB" >/dev/null 2>&1 &
else
  nohup "$RESTART_JOB" >/dev/null 2>&1 &
fi

log "[2/4] 停止当前 VNC..."
vncserver -kill ":$DISPLAY_NUM" || true

log "[3/4] 清理 Xvnc..."
kill_xvnc "$CURRENT_USER" "$DISPLAY_NUM" || true

log "[4/4] 删除锁文件..."
rm -f "/tmp/.X${DISPLAY_NUM}-lock"
rm -f "/tmp/.X11-unix/X${DISPLAY_NUM}"

log
log "已提交后台重启任务，请稍等几秒后重新连接 VNC。"
